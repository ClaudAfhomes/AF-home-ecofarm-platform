# JAD monorepo — root environment template.
# Per-app variables live in each app's own `.env.example`.
# Secrets are NEVER committed. Only `VITE_`-prefixed vars ship to the client bundle
# (DEVELOPMENT-GUIDELINES §18).

# Supabase Auth seed — Phase 1 (local .env only, never commit)
# SUPABASE_SEED_ADMIN_PASSWORD=your-admin-password  # for admin@jad.local
# SUPABASE_SEED_USER_PASSWORD=your-user-password   # for user@jad.local
# Required for pnpm seed: VITE_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL
#
# DATABASE_URL for `pnpm db:migrate` must be the current transaction-pooler
# connection string (Dashboard → Settings → Database → Connect):
#   DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
# The legacy direct host `db.<ref>.supabase.co` no longer resolves.

# Production super-admin provisioning (local .env only, never commit).
# Used by `pnpm provision:superadmin` after `pnpm purge:core --execute`.
# SUPABASE_PROD_SUPERADMIN_EMAIL=admin@example.com
# SUPABASE_PROD_SUPERADMIN_PASSWORD=your-strong-password-min-12-chars
# SUPABASE_PROD_SUPERADMIN_NAME=Super Admin
# Optional guards: PURGE_KEEP_AUTH_EMAILS=keep@example.com (purge keep-list),
# DEV_RESET_ALLOW_REFS=<project-ref> (required for any --execute run)

# Reverse geolocation — Nominatim (OpenStreetMap) — server-only, never VITE_
# Resolves GPS lat/lon → ISO country for POST /api/v1/registration/location-verify
# Nominatim requires a valid User-Agent per https://operations.osmfoundation.org/policies/nominatim/
# No API key for default OSM endpoint; self-hosted alternative via REVERSE_GEO_PROVIDER_URL
# REVERSE_GEO_PROVIDER_URL=https://nominatim.openstreetmap.org/reverse
# REVERSE_GEO_USER_AGENT=jad-realty/1.0 (contact: support@jad.local)
# REVERSE_GEO_REFERER=https://jad-realty.vercel.app
# REVERSE_GEO_TIMEOUT_MS=4000

# Verification emails — EmailJS (server-only, never VITE_)
# Registration/verify/resend send the 6-digit code through the EmailJS REST
# API (https://api.emailjs.com/api/v1.0/email/send), not Supabase SMTP.
# In EmailJS: connect an Email Service (e.g. Gmail), then create a template
# with params {{to_email}}, {{to_name}}, {{verification_code}},
# {{app_name}}, {{expiry_minutes}}. Mirror these values in Vercel env.
# EMAILJS_SERVICE_ID=service_xxxxxxx
# EMAILJS_TEMPLATE_ID=template_xxxxxxx
# EMAILJS_PUBLIC_KEY=your-emailjs-public-key
# EMAILJS_PRIVATE_KEY=your-emailjs-private-key (optional, enables accessToken auth)
# Server-side pepper for code hashes (optional; falls back to the service key):
# EMAIL_OTP_PEPPER=a-long-random-string
